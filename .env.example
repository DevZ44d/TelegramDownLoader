# Telegram API credentials (https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Telethon StringSession for the user account
# Required for Stories + restricted content
SESSION_STRING=

# Path of cookies.txt file
INSTAGRAM_COOKIES=

# Session file name for Telethon (file-based fallback)
SESSION_ACCOUNT_NAME=session_account

# Developer contact
DEVELOPER_URL=https://t.me/DevGit

# Temporary download directory
DOWNLOAD_DIR=downloads

# Max file size in MB
MAX_FILE_SIZE_MB=2000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
